{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cad-agents.local/schemas/phase1/parametric_dsl.schema.json",
  "title": "Phase 1 Parametric DSL",
  "type": "object",
  "required": ["traceability_id", "units", "parameters", "features", "derivative_outputs"],
  "properties": {
    "traceability_id": {
      "type": "string",
      "pattern": "^tr_dsl_[A-Za-z0-9_]+$"
    },
    "units": {
      "const": "mm"
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number"
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {"const": "box"},
              "length_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "width_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "height_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "length_mm", "width_mm", "height_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "cylinder"},
              "radius_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "height_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "radius_mm", "height_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "through_hole"},
              "axis": {"type": "string", "enum": ["z"]},
              "diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "depth_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "axis", "diameter_mm", "depth_mm", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "gear"},
              "module_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "teeth": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "bore_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "module_mm", "teeth", "thickness_mm", "bore_diameter_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "escape_wheel"},
              "teeth": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "tip_radius_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "bore_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "tooth_type": {"type": "string", "enum": ["pointed", "club"]},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "teeth", "tip_radius_mm", "thickness_mm", "bore_diameter_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "balance_wheel"},
              "outer_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "rim_width_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "spokes": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "bore_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "outer_diameter_mm", "rim_width_mm", "spokes", "thickness_mm", "bore_diameter_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "lever"},
              "length_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "width_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "fork_width_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "pivot_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "length_mm", "width_mm", "thickness_mm", "fork_width_mm", "pivot_diameter_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "cage"},
              "outer_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "arm_count": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "bore_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "bridge": {"type": "boolean"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "outer_diameter_mm", "arm_count", "thickness_mm", "bore_diameter_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "hairspring"},
              "outer_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "coils": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "wire_diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "outer_diameter_mm", "coils", "wire_diameter_mm", "thickness_mm", "axis", "positions_mm"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {"const": "jewel"},
              "diameter_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "thickness_mm": {"type": "string", "pattern": "^\\$[A-Za-z_][A-Za-z0-9_]*$"},
              "axis": {"type": "string", "enum": ["z"]},
              "positions_mm": {"$ref": "#/$defs/coordinate_pair_array"}
            },
            "required": ["op", "diameter_mm", "thickness_mm", "axis", "positions_mm"],
            "additionalProperties": false
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "const": "box"
                }
              },
              "required": ["op"]
            },
            "then": {
              "required": ["length_mm", "width_mm", "height_mm"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "cylinder"
                }
              },
              "required": ["op"]
            },
            "then": {
              "required": ["radius_mm", "height_mm", "axis", "positions_mm"]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "through_hole"
                }
              },
              "required": ["op"]
            },
            "then": {
              "required": ["axis", "diameter_mm", "depth_mm", "positions_mm"]
            }
          }
        ]
      }
    },
    "derivative_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "step_ap242"
      },
      "items": {
        "enum": ["step_ap242", "stl"]
      }
    }
  },
  "$defs": {
    "coordinate_pair_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    }
  },
  "additionalProperties": false
}
